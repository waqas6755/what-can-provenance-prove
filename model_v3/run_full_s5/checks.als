-- ================================================================
-- Paper 3 provenance assurance model, v3 (30 Oct 2026) = v2 + goal G_complete.
-- Paper 3 provenance assurance model, v2 (25 Oct 2026).
-- Reconciles the 15 Oct per-stage model (formal_model.md, checker/) with
-- the 18 Oct Alloy model (model/pipeline_base.als).  Changes from v1:
--  (1) two witness mechanisms, which v1 conflated:
--        WitSrc : signed delivery receipts from authorised sources; the auditor
--                 rejects committed items not covered by a receipt (blocks injection)
--        WitIn  : independent observer of the inputs delivered to the training
--                 executor, under complete mediation; the auditor rejects a record
--                 that omits a delivered input (blocks omission; 15 Oct "Wit")
--  (2) two binding mechanisms: BindFix (seed fixed independently of the data)
--      and BindGrind (prover chooses the seed after seeing the data)
--  (3) a detector is meaningful only if deployed and its attestation holds;
--      v1 left the miss set unconstrained without a detector (artefact)
--  (4) adversary capabilities against the trust base: AdvWit (witness lies),
--      AdvTEE (attestation keys / TEE broken)
--  (5) adversary configurations are swept, not only the full adversary
-- P1-P3 of the evidence store are still assumed.  Items are atomic: two
-- different contents are two different items, i.e. receipts are assumed to be
-- content-addressed (assumption A-CA; see the split-view note in the report).
-- ================================================================
module pipeline_v3

sig Item {}

one sig W {
  delivered : set Item,   -- delivered by authorised sources
  synth     : set Item,   -- legitimately generated by the declared generator
  filtered  : set Item,   -- actual output of the transform = inputs delivered to training
  committed : set Item,   -- items committed in the record
  used      : set Item,   -- items that determine the released model
  audSynth  : set Item,   -- the synthetic set as the auditor learns it
  audD      : set Item,   -- source deliveries as reported by WitSrc
  audF      : set Item,   -- training inputs as reported by WitIn
  bad       : set Item,   -- poisoned items
  missed    : set Item,   -- poisoned items the detector misses (recall gap)
  examined  : set Item    -- items an attested detector actually examined
}

lone sig Gen {}                          -- a generative stage is declared
lone sig GroundSeed {}                   -- the training seed was chosen after seeing the data

-- mechanisms
lone sig BindFix, BindGrind, WitSrc, WitIn, AttCap, AttTrans, Detector {}
lone sig PerfectDetector {}              -- assumption knob: detector recall = 1

-- adversary capabilities
lone sig AdvSource, AdvGen, AdvTrans, AdvCap, AdvExec, AdvWit, AdvTEE {}

pred bound { some BindFix or some BindGrind }
pred teeOK { no AdvTEE }

fact Domains {
  no W.delivered & W.synth
  no Gen implies (no W.synth and no W.audSynth)    -- declared stage types (v1 fix)
  W.missed in W.bad
  some PerfectDetector implies no W.missed
  no AdvSource implies no W.bad & W.delivered
  no AdvGen implies no W.bad & W.synth
}
fact Transform {
  (no AdvTrans or (some AttTrans and teeOK)) implies W.filtered in W.delivered + W.synth
}
fact SynthReport {
  (some AttTrans and teeOK) implies W.audSynth = W.synth
  (no AdvTrans and no AdvCap) implies W.audSynth = W.synth
}
fact Capture {
  (no AdvCap or (some AttCap and teeOK)) implies W.committed = W.filtered
}
fact Execution {
  no AdvExec implies W.used = W.filtered
  some GroundSeed implies (some AdvExec and no BindFix)
}
fact Witnesses {
  no AdvWit implies (W.audD = W.delivered and W.audF = W.filtered)
}
fact DetectorScope {
  (some Detector and teeOK) implies W.examined = W.committed
  (no Detector or not teeOK) implies no W.examined
}

pred Accepted {
  bound implies W.used = W.committed
  some WitSrc implies W.committed in W.audD + W.audSynth
  some WitIn  implies W.audF in W.committed
  (some Detector and teeOK) implies (W.committed & W.bad) in W.missed
}

-- goals
pred G_bind    { W.used = W.committed }                       -- record explains the model's inputs exactly
pred G_auth    { W.used in W.delivered + W.synth }            -- no unauthorised lineage
pred G_noinf   { W.used = W.committed and no GroundSeed }     -- nothing outside the record shaped the model
pred G_content { (W.used & W.bad) in (W.missed & W.examined) }-- residual poison = what an attested detector examined and missed
pred G_zero    { no W.used & W.bad }                          -- no poison at all
pred G_complete { W.filtered in W.committed }                 -- v3: record omits no training input (P4, capture completeness)

-- generated
check c0 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_bind } for 5
check c1 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_auth } for 5
check c2 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_noinf } for 5
check c3 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_content } for 5
check c4 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_zero } for 5
check c5 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_complete } for 5
check c6 { (no Gen and no PerfectDetector and some BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_bind } for 5
check c7 { (no Gen and no PerfectDetector and some BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_auth } for 5
check c8 { (no Gen and no PerfectDetector and some BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_noinf } for 5
check c9 { (no Gen and no PerfectDetector and some BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_content } for 5
check c10 { (no Gen and no PerfectDetector and some BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_zero } for 5
check c11 { (no Gen and no PerfectDetector and some BindFix and no BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_complete } for 5
check c12 { (no Gen and no PerfectDetector and no BindFix and some BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_bind } for 5
check c13 { (no Gen and no PerfectDetector and no BindFix and some BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_auth } for 5
check c14 { (no Gen and no PerfectDetector and no BindFix and some BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_noinf } for 5
check c15 { (no Gen and no PerfectDetector and no BindFix and some BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_content } for 5
check c16 { (no Gen and no PerfectDetector and no BindFix and some BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_zero } for 5
check c17 { (no Gen and no PerfectDetector and no BindFix and some BindGrind and no WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_complete } for 5
check c18 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and some WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_bind } for 5
check c19 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and some WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_auth } for 5
check c20 { (no Gen and no PerfectDetector and no BindFix and no BindGrind and some WitSrc and no WitIn and no AttCap and no AttTrans and no Detector and some AdvSource and some AdvGen and some AdvTrans and some AdvCap and some AdvExec and no AdvWit and no AdvTEE and Accepted) implies G_noinf } for 5
